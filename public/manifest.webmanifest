    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Classes", "url": "/#classes", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mess menu", "url": "/#mess", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Shuttle", "url": "/#bus", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Lost & found", "url": "/#lost", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]

{
  "name": "iimk-campus-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "IIMK Campus Hub: timetable, attendance, carpool, lost & found, buy & sell, laundry, bus, mess menu and contacts for IIM Kozhikode students.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed:timetable": "node scripts/gen-timetable-seed.mjs > supabase/seed_timetable.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.8"
  }
}
